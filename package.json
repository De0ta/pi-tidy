{
  "name": "pi-tidy",
  "version": "0.4.14",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "description": "Tool folding for the pi agent — a reply's tool calls collapse to one clickable line; failures, edit diffs and running jobs stay visible",
  "license": "MIT",
  "author": "Andy8647",
  "keywords": [
    "pi-package",
    "pi-extension",
    "transcript",
    "tool-calls",
    "tool-folding",
    "claude-code",
    "pi-processes",
    "tool-rendering",
    "mcp",
    "syntax-highlighting"
  ],
  "files": [
    "*.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Andy8647/pi-tidy/main/assets/cover.png",
    "video": "https://cdn.jsdelivr.net/gh/Andy8647/pi-tidy@v0.4.3/assets/demo.mp4"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andy8647/pi-tidy.git"
  },
  "homepage": "https://github.com/Andy8647/pi-tidy#readme",
  "bugs": {
    "url": "https://github.com/Andy8647/pi-tidy/issues"
  }
}
